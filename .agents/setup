#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "$repo_root"

# Match .github/workflows/ci.yml. Stack selects GHC from stack.yaml.lock.
# The orb's own Node satisfies tests/support/package.json's engines range.
stack_version=3.3.1
# On PATH in every orb shell, and kept by project snapshots.
bin="$HOME/.local/bin"
export npm_config_audit=false npm_config_fund=false npm_config_update_notifier=false
TIMEFORMAT='Finished in %3R seconds'

run() {
  printf '\n==> %s\n' "$1"
  shift
  time "$@"
}

missing=()
for package in build-essential ca-certificates curl git libffi-dev libgmp-dev libncurses-dev libtinfo6 netbase pkg-config xz-utils zlib1g-dev; do
  if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  run 'Update system package index' sudo apt-get update
  run 'Install missing build prerequisites' sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

# Earlier versions of this script kept Stack and Node here, on a PATH that
# shared snapshots did not keep.
rm -rf -- "$HOME/.local/share/purescript-orb"

if [[ "$(stack --numeric-version 2>/dev/null || true)" != "$stack_version" ]]; then
  scratch="$(mktemp -d)"
  trap 'rm -rf -- "$scratch"' EXIT
  archive="stack-$stack_version-linux-x86_64.tar.gz"
  run "Download Stack $stack_version" curl -fLsS --retry 3 \
    "https://github.com/commercialhaskell/stack/releases/download/v$stack_version/$archive" -o "$scratch/$archive"
  echo "88d7e517342c125b0a098d9d578fe53e590618ae4b2427283a27408a1ebd06d8  $scratch/$archive" | sha256sum --check
  tar -xzf "$scratch/$archive" -C "$scratch"
  mkdir -p "$bin"
  install -m 755 "$scratch/stack-$stack_version-linux-x86_64/stack" "$bin/stack"
fi

# These are independent, so run them at the same time. Casa lacks some of
# the pinned packages, which makes Stack fall back to the Hackage index
# (1 GB to download and index); fetch it alongside GHC rather than after.
# Concurrent first runs race to create the Stack root, so create it first
# (install-ghc is already Stack's default).
stack --no-terminal config set install-ghc true --global
pids=()
run 'Install the resolver-pinned GHC' stack --no-terminal setup &
pids+=($!)
if [[ ! -f "${STACK_ROOT:-$HOME/.stack}/pantry/hackage/00-index.tar" ]]; then
  run 'Download the Hackage index' stack --no-terminal update &
  pids+=($!)
fi
# This repository deliberately ignores package-lock.json. npm install keeps
# an existing node_modules tree, unlike npm ci, and matches TestUtils.hs.
run 'Install JavaScript test dependencies' npm install --prefix tests/support --prefer-offline &
pids+=($!)
for pid in "${pids[@]}"; do wait "$pid"; done

# Scale package compilation to the selected orb size.
run 'Build Haskell dependencies' stack --no-terminal --jobs="$(nproc)" \
  build --fast --test --only-dependencies --lock-file=error-on-write

# Prebuild purs and the test suite the way CONTRIBUTING.md recommends, so the
# first `stack build --fast` or `stack test --fast` in a thread is incremental.
# A broken base branch should not stop the dependency cache from being saved.
if run 'Build purs and its tests (--fast)' stack --no-terminal --jobs="$(nproc)" \
  build --fast --test --no-run-tests --lock-file=error-on-write; then
  # Do what TestUtils.updateSupportCode does, so the test suite skips it for a
  # day. spago needs purs on PATH, which stack exec provides.
  rm -rf tests/support/.spago
  run 'Fetch PureScript test packages' stack --no-terminal exec --cwd tests/support -- \
    node node_modules/spago/bin/bundle.js fetch
  touch tests/support/.last_updated
else
  printf '\nWarning: purs did not build; dependencies are cached, but the first build will be slow.\n'
fi

printf '\nReady: stack build --fast; stack test --fast\n'
printf 'Total setup time: %s seconds\n' "$SECONDS"
